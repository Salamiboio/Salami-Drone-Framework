BaseGameTriggerEntity HQ {
 coords 1401.159 36.072 2335.364
 userScript "	private string m_sFactionKey = \"US\";"\
 "	"\
 "	void KillPlayer(IEntity ent)"\
 "	{"\
 "		EntitySpawnParams spawnParams = new EntitySpawnParams();"\
 "		vector transform[4];"\
 "		ent.GetTransform(transform);"\
 "		spawnParams.Transform = transform;"\
 "		IEntity lightning = GetGame().SpawnEntityPrefab(Resource.Load(\"{A8FFCD3F3697D77F}Prefabs/Editor/Lightning/LightningStrike.et\"), GetGame().GetWorld(), spawnParams);"\
 "	}"
 TriggerShapeType Sphere
 SphereRadius 32.4
 DrawShape 1
 PeriodicQueries 1
 UpdatePeriod 5
 OnQueryFinished ""\
 "		#ifdef WORKBENCH"\
 "		#else"\
 "		if (RplSession.Mode() == RplMode.Client)"\
 "			return;"\
 "		#endif"\
 "		SCR_FactionManager factManager = SCR_FactionManager.Cast(GetGame().GetFactionManager());"\
 "		ref array<int> playerIds = {};"\
 "		GetGame().GetPlayerManager().GetPlayers(playerIds);"\
 "		"\
 "		foreach (int playerId: playerIds)"\
 "		{"\
 "			IEntity ent = GetGame().GetPlayerManager().GetPlayerControlledEntity(playerId);"\
 "			if (!ent)"\
 "				continue;"\
 "			"\
 "			if (!ent.FindComponent(SCR_CharacterControllerComponent))"\
 "				continue;"\
 "			"\
 "			if (SCR_CharacterControllerComponent.Cast(ent.FindComponent(SCR_CharacterControllerComponent)).IsDead())"\
 "				continue;"\
 "			"\
 "			if (!factManager.GetPlayerFaction(playerId))"\
 "				continue;"\
 "			"\
 "			if (factManager.GetPlayerFaction(playerId).GetFactionKey() == m_sFactionKey)"\
 "				continue;"\
 "			"\
 "			float distance = vector.Distance(this.GetOrigin(), ent.GetOrigin());"\
 "			if (distance < GetSphereRadius())"\
 "				KillPlayer(ent);"\
 "		}"\
 "	"
}
